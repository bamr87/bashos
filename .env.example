# bashOS runs the OpenCode engine on your Claude Code login by default —
# nothing is needed in this file if `opencode` is installed and the `claude`
# CLI is logged in (subscription OAuth).
#   npm i -g opencode-ai   (or: curl -fsSL https://opencode.ai/install | bash)

# ── auth ─────────────────────────────────────────────────────────────────────
# Headless / CI / containers: mint a long-lived OAuth token with `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# Direct API billing instead of Claude Code (fallback credential):
# ANTHROPIC_API_KEY=sk-ant-api03-...
# Wire no credential at all; let the engine use whatever it already has:
# BASHOS_OPENCODE_AUTH=never

# ── engine ───────────────────────────────────────────────────────────────────
# Attach to an engine you run yourself (`bashos opencode serve` prints both):
# BASHOS_OPENCODE_URL=http://127.0.0.1:4096
# BASHOS_OPENCODE_PASSWORD=...
# Pin opencode.jsonc instead of regenerating it at engine start:
# BASHOS_OPENCODE_SYNC=0

# ── kernel ───────────────────────────────────────────────────────────────────
# BASHOS_MODEL=claude-opus-5
# BASHOS_BACKEND=opencode      # or: claude-code | api
# BASHOS_MAX_OUTPUT_TOKENS=16000
# BASHOS_REACT_MAX_TURNS=12

# ── observability (optional) ─────────────────────────────────────────────────
# Trace kernel runs to Arize Phoenix (requires: pip install -e ".[trace]").
# Point at any Phoenix — the bundled compose service or one you already run:
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# BASHOS_TRACE=1

# ── docker host ports (compose) ──────────────────────────────────────────────
# Remap when another stack already binds the defaults (e.g. an existing Phoenix):
# BASHOS_PHOENIX_UI_PORT=6007
# BASHOS_PHOENIX_GRPC_PORT=4318
# BASHOS_LANGGRAPH_PORT=2024
