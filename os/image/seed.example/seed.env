# A first-boot seed for a bashOS image (os/bin/bashos-provision). Copy this directory, edit it,
# and put it on a FAT/ISO volume labelled BASHOS-SEED plugged in at the first boot (or bake it
# with `bashos os image build --seed DIR`). KEY=value lines only — the file is read, never run.

# The machine's person and name.
BASHOS_USER=amr
BASHOS_HOSTNAME=forge
BASHOS_SHELL=zsh
BASHOS_TIMEZONE=America/Denver
BASHOS_LOCALE=en_US.UTF-8

# A password hash (openssl passwd -6), or leave it empty for keys-only ssh plus console autologin.
BASHOS_PASSWORD_HASH=
# yes: sudo without a password (what forge's `sudo -n` probes expect). Anyone at the keyboard of an
# autologin console is then root — the physical-access trade forge already makes.
BASHOS_SUDO_NOPASSWD=no

# Written into /etc/bashos/os.conf (see os/config/os.conf for every setting).
BASHOS_CONSOLE=auto
BASHOS_HARNESS=native
BASHOS_HARNESS_HOST=127.0.0.1
BASHOS_HARNESS_PORT=4001
BASHOS_LAN_CIDR=
