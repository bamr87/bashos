#!/bin/bash
# oneusb-task — run the task the boot menu asked for (kernel argument oneusb.task=…).
# Started from the desktop session (xdg autostart); does nothing on a normal boot.
task="$(tr ' ' '\n' </proc/cmdline | sed -n 's/^oneusb\.task=//p' | tail -1)"
case "$task" in
  steamos-install)
    exec xfce4-terminal --maximize --title "Install SteamOS" -x sudo /usr/local/bin/oneusb-steamos ;;
  "") exit 0 ;;
  *) echo "oneusb-task: unknown task '$task'" >&2; exit 1 ;;
esac
