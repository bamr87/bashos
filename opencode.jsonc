{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5",
  "agent": {
    "bashos": {
      "description": "bashOS inspection agent — read-only probes on the real machine",
      "mode": "primary",
      "model": "anthropic/claude-opus-5",
      "prompt": "You are bashOS — a terminal-native AI runtime for software development and\ninformation systems. You live in a shell, and your output renders in one.\n\nStyle: precise and senior; no filler. Use fenced code blocks for anything\nrunnable and simple markdown tables for data. Never use HTML.\n\nShell discipline: code must be shellcheck-clean and defensively quoted. Prefer\nportable POSIX unless the task targets a specific shell; call out macOS/BSD vs\nGNU differences when flags differ. Never invent flags or commands. Treat any\ndestructive operation (rm, dd, mkfs, forced git, DROP, truncation) as requiring\nan explicit warning and a safe preview first.\n\nA [host] line describing this machine may be appended to requests — trust it\nover assumptions.\nYou are running as a bashOS inspection agent. Your tools are read-only by\npolicy: file reads and searches are allowed, `bash` is restricted to an\nallowlist of diagnostic probes, and every mutating or outbound tool is denied.\nDo not attempt work outside that boundary — report what you find instead.",
      "maxSteps": 12,
      "tools": {
        "bash": true,
        "read": true,
        "glob": true,
        "grep": true,
        "list": true,
        "edit": false,
        "write": false,
        "apply_patch": false,
        "webfetch": false,
        "websearch": false,
        "task": false
      },
      "permission": {
        "bash": {
          "*": "deny",
          "uname": "allow",
          "uname *": "allow",
          "uptime": "allow",
          "uptime *": "allow",
          "df": "allow",
          "df *": "allow",
          "du": "allow",
          "du *": "allow",
          "ps": "allow",
          "ps *": "allow",
          "top": "allow",
          "top *": "allow",
          "vm_stat": "allow",
          "vm_stat *": "allow",
          "free": "allow",
          "free *": "allow",
          "sw_vers": "allow",
          "sw_vers *": "allow",
          "sysctl": "allow",
          "sysctl *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "which": "allow",
          "which *": "allow",
          "whoami": "allow",
          "whoami *": "allow",
          "id": "allow",
          "id *": "allow",
          "date": "allow",
          "date *": "allow",
          "netstat": "allow",
          "netstat *": "allow",
          "head": "allow",
          "head *": "allow",
          "wc": "allow",
          "wc *": "allow",
          "file": "allow",
          "file *": "allow",
          "stat": "allow",
          "stat *": "allow",
          "env": "allow",
          "env *": "allow",
          "git status": "allow",
          "git status *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "bin/os-health": "allow",
          "bin/os-health *": "allow",
          "./bin/os-health": "allow",
          "./bin/os-health *": "allow",
          "tmux list-": "allow",
          "tmux list- *": "allow",
          "tmux capture-pane": "allow",
          "tmux capture-pane *": "allow",
          "tmux has-session": "allow",
          "tmux has-session *": "allow",
          "tmux display-message": "allow",
          "tmux display-message *": "allow"
        },
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
