# Base of the home base. Desktop + extra_packages come from manifest.yaml
# (generated into manifest.list.chroot at build time).
live-boot
live-config
live-config-systemd
# live-config Recommends, needed because we build with --apt-recommends false:
# user-setup creates the live "user" account (no account → no login/autologin).
user-setup
locales
# Control channel for scripts/oneos-vm and the harness (ADR-0004). Only starts when
# a virtio port named org.qemu.guest_agent.0 exists, i.e. inside our VMs.
qemu-guest-agent
