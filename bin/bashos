#!/usr/bin/env bash
# bashOS launcher — bootstraps a virtualenv on first run, then hands off.
set -Eeuo pipefail

# Resolve symlinks: the OS layer puts this script on PATH as /usr/local/bin/bashos.
_src="${BASH_SOURCE[0]}"
while [[ -L $_src ]]; do
  _dir="$(cd "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ $_src == /* ]] || _src="$_dir/$_src"
done
ROOT="$(cd "$(dirname "$_src")/.." && pwd)"
unset _src _dir
VENV="${ROOT}/.venv"

# The macOS terminal environment (chui/) and the Linux OS layer (os/) are plain shell: they run
# before any Python exists, so a fresh Mac can `bin/bashos chui install` and a fresh Debian box
# `bin/bashos os install` without a virtualenv.
case "${1:-}" in
  chui) shift; exec "${ROOT}/chui/tui.sh" "$@" ;;
  os) shift; exec "${ROOT}/os/os.sh" "$@" ;;
esac

if [[ ! -x "${VENV}/bin/bashos" ]]; then
  echo "bashos: first run — creating ${VENV}" >&2
  python3 -m venv "${VENV}"
  "${VENV}/bin/pip" --quiet install --upgrade pip
  "${VENV}/bin/pip" --quiet install -e "${ROOT}"
fi

exec "${VENV}/bin/bashos" "$@"
