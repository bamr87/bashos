#!/usr/bin/env bash
# bashOS launcher — bootstraps a virtualenv on first run, then hands off.
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${ROOT}/.venv"

# The macOS terminal environment (chui/) is plain shell: it runs before any Python exists,
# so a fresh Mac can `bin/bashos chui install` without a virtualenv.
if [[ "${1:-}" == chui ]]; then
  shift
  exec "${ROOT}/chui/tui.sh" "$@"
fi

if [[ ! -x "${VENV}/bin/bashos" ]]; then
  echo "bashos: first run — creating ${VENV}" >&2
  python3 -m venv "${VENV}"
  "${VENV}/bin/pip" --quiet install --upgrade pip
  "${VENV}/bin/pip" --quiet install -e "${ROOT}"
fi

exec "${VENV}/bin/bashos" "$@"
