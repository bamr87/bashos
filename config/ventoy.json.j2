{
  "control": [
    { "VTOY_DEFAULT_SEARCH_ROOT": "/ISO" },
    { "VTOY_MENU_TIMEOUT": "{{ m.ventoy.menu_timeout }}" },
    { "VTOY_DEFAULT_IMAGE": "/{{ m.lightos.file }}" },
    { "VTOY_LINUX_REMOUNT": "1" },
    { "VTOY_SECONDARY_BOOT_MENU": "0" }
  ],
  "persistence": [
    { "image": "/{{ m.lightos.file }}", "backend": "/persistence/lightos.dat", "autosel": 1, "timeout": 3 }
  ],
{#- Ventoy plugin keys take a _uefi / _legacy suffix to apply in one firmware mode only. #}
{%- for mode, other in [("uefi", "legacy"), ("legacy", "uefi")] %}
  "image_blacklist_{{ mode }}": [
    {%- for a in artifacts if a.mode == other and a.file in present %}
    "/{{ a.file }}"{{ "," if not loop.last }}
    {%- endfor %}
  ],
{%- endfor %}
  "menu_alias": [
    { "image": "/{{ m.lightos.file }}", "alias": "Home base (persistent)" }
{%- for a in artifacts if a.alias and a.file in present %},
    { "image": "/{{ a.file }}", "alias": {{ a.alias | tojson }} }
{%- endfor %}
  ]
}
